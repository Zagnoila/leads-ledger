{
  "manifest_version": 3,
  "name": "Leads Ledger",
  "version": "1.0.0",
  "description": "Save a website or the current tab to a personal list of leads.",
  "permissions": ["activeTab"],
  "icons": {"128": "icon.png"},
  "action": {
    "default_title": "Open Leads Ledger",
    "default_popup": "index.html",
    "default_icon": {"128": "icon.png"}
  }
}
